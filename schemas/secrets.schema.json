{
  "$id": "urn:runestra:schema:secrets",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "brevo_api_key": {
      "type": "string"
    },
    "github_client_secret": {
      "type": "string"
    },
    "google_client_secret": {
      "type": "string"
    },
    "webhook_triggers": {
      "additionalProperties": {
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "github"
                }
              },
              "required": [
                "provider"
              ]
            },
            "then": {
              "required": [
                "repository"
              ]
            }
          }
        ],
        "properties": {
          "actions": {
            "default": [
              "opened"
            ],
            "type": "array"
          },
          "event": {
            "default": "issues",
            "type": "string"
          },
          "input_mapping": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "minProperties": 1,
            "type": "object"
          },
          "project": {
            "minLength": 1,
            "type": "string"
          },
          "provider": {
            "enum": [
              "github",
              "hmac"
            ]
          },
          "repository": {
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "secret": {
            "minLength": 32,
            "type": "string"
          },
          "workflow": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "provider",
          "secret",
          "project",
          "workflow",
          "input_mapping"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "type": "object"
    }
  },
  "type": "object"
}
